[0m17:16:13.062456 [debug] [Thread-1 (]: On model.esg_analytics.fact_esg_score_risk: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "esg_trino", "target_name": "dev", "node_id": "model.esg_analytics.fact_esg_score_risk"} */

  
    

    create table "delta"."default_marts"."fact_esg_score_risk"
      
      
    as (
      

with level_scores as (
    select
        c.company_id,
        e.year,
        'esg_level' as source,
        null as environmental_score,
        null as social_score,
        null as governance_score,
        (e.environment_score + e.social_score + e.governance_score) / 3.0 as overall_score,
        e.environment_level,
        e.social_level,
        e.governance_level,
        e.total_level,
        e.environment_grade,
        e.social_grade,
        e.governance_grade,
        e.total_grade,
        null as risk_score,
        null as risk_level
    from "delta"."default"."clean_esg_level_score" e
    join "delta"."default_marts"."dim_company" c 
        on upper(trim(e.ticker)) = upper(trim(c.symbol))
        or lower(trim(e.company_name)) = lower(trim(c.company_name_normalized))
    where e.year is not null
),

risk_scores as (
    select
        c.company_id,
        year(r.scraped_date) as year,
        'sp500_risk' as source,
        100.0 - r.environment_risk_score as environmental_score,
        100.0 - r.social_risk_score as social_score,
        100.0 - r.governance_risk_score as governance_score,
        100.0 - r.total_esg_risk_score as overall_score,
        null as environment_level,
        null as social_level,
        null as governance_level,
        r.esg_risk_level as total_level,
        null as environment_grade,
        null as social_grade,
        null as governance_grade,
        null as total_grade,
        r.total_esg_risk_score as risk_score,
        r.esg_risk_level as risk_level
    from "delta"."default"."clean_sp500_esg_risk" r
    join "delta"."default_marts"."dim_company" c 
        on upper(trim(r.ticker)) = upper(trim(c.symbol))
        or lower(trim(r.company_name)) = lower(trim(c.company_name_normalized))
    where r.scraped_date is not null
),

rank_scores as (
    select
        c.company_id,
        r.year_benchmarked as year,
        'sustainability_rank' as source,
        r.ecosystems_biodiversity_score as environmental_score,
        r.social_community_score as social_score,
        r.governance_strategy_score as governance_score,
        r.total_score as overall_score,
        null as environment_level,
        null as social_level,
        null as governance_level,
        null as total_level,
        null as environment_grade,
        null as social_grade,
        null as governance_grade,
        null as total_grade,
        null as risk_score,
        null as risk_level
    from "delta"."default"."clean_sustainability_rank" r
    join "delta"."default_marts"."dim_company" c 
        on trim(r.isin) = trim(c.isin)
        or lower(trim(r.company_name)) = lower(trim(c.company_name_normalized))
    where r.year_benchmarked is not null
        and r.year_benchmarked > 0
),

industrials_scores as (
    select
        c.company_id,
        year(i.last_updated) as year,
        'industrials' as source,
        i.environment_score as environmental_score,
        i.social_score as social_score,
        i.governance_score as governance_score,
        i.total_esg_score as overall_score,
        null as environment_level,
        null as social_level,
        null as governance_level,
        null as total_level,
        i.environment_grade,
        i.social_grade,
        i.governance_grade,
        null as total_grade,
        null as risk_score,
        null as risk_level
    from "delta"."default"."clean_industrials_esg_score" i
    join "delta"."default_marts"."dim_company" c 
        on upper(trim(i.symbol)) = upper(trim(c.symbol))
        or lower(trim(i.company_name)) = lower(trim(c.company_name_normalized))
    where i.last_updated is not null
),

esg_crawled_scores as (
    select
        c.company_id,
        year(e.last_updated) as year,
        'esg_crawled' as source,
        e.esg_score * 0.33 as environmental_score,
        e.esg_score * 0.33 as social_score,
        e.csa_score as governance_score,
        e.esg_score as overall_score,
        null as environment_level,
        null as social_level,
        null as governance_level,
        null as total_level,
        null as environment_grade,
        null as social_grade,
        null as governance_grade,
        null as total_grade,
        null as risk_score,
        null as risk_level
    from "delta"."default"."clean_esg_score" e
    join "delta"."default_marts"."dim_company" c 
        on lower(trim(e.company)) = lower(trim(c.company_name_normalized))
    where e.last_updated is not null
        and e.esg_score is not null
),

all_scores as (
    select * from level_scores
    union all
    select * from risk_scores
    union all
    select * from rank_scores
    union all
    select * from industrials_scores
    union all
    select * from esg_crawled_scores
)

select
    md5(concat(
        cast(company_id as varchar),
        cast(year as varchar),
        source
    )) as score_key,
    company_id,
    year,
    source,
    environmental_score,
    social_score,
    governance_score,
    overall_score,
    environment_level,
    social_level,
    governance_level,
    total_level,
    environment_grade,
    social_grade,
    governance_grade,
    total_grade,
    risk_score,
    risk_level,
    current_timestamp as created_at,
    current_timestamp as updated_at
from all_scores
where company_id is not null
    and year is not null
    and year between 2015 and 2030
    )
