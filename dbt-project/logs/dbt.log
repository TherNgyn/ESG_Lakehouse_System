    create table "delta"."default_marts"."dim_company"
      
      
    as (
      

with companies as (
    select
        matched_company_id as company_id,
        company_name, -
        isin,
        sector,
        industry,
        sub_industry,
        city,
        country,
        region,
        initcap(name_norm) as name_norm_init,
        initcap(sector_norm) as sector_norm_init,
        initcap(industry_norm) as industry_norm_init,
        initcap(country_norm) as country_norm_init,
        isin_valid,
        row_number() over (partition by matched_company_id order by 
            case 
                when isin_valid = true then 1
                when sector is not null then 2
                when industry is not null then 3
                else 4
            end
        ) as rn
    from "delta"."default"."staging_companies_mapping"
),

deduplicated as (
    select
        company_id,
        company_name,
        symbol,
        isin,
        sector,
        industry,
        sub_industry,
        city,
        country,
        region,
        name_norm_init,
        sector_norm_init,
        industry_norm_init,
        country_norm_init,
        isin_valid
    from companies
    where rn = 1
)

select
    company_id,
    company_name, 
    symbol,
    isin,
    sector,
    industry,
    sub_industry,
    city,
    country,
    region,
    name_norm_init as company_name_normalized,
    sector_norm_init as sector_normalized,
    industry_norm_init as industry_normalized,
    country_norm_init as country_normalized,
    isin_valid as has_valid_isin,
    current_timestamp as created_at,
    current_timestamp as updated_at
from deduplicated
    )
[0m16:26:32.203250 [debug] [Thread-2 (]: On model.esg_analytics.dim_date: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "esg_trino", "target_name": "dev", "node_id": "model.esg_analytics.dim_date"} */

  
    

    create table "delta"."default_marts"."dim_date"
      
      
    as (
      

SELECT 
    date_column,
    EXTRACT(YEAR FROM date_column) AS year,
    EXTRACT(MONTH FROM date_column) AS month,
    date_column + INTERVAL '1' DAY AS next_day 
FROM "delta"."default_util"."time_spine"

date_details as (
    select
        date_day,
        year(date_day) as year,
        month(date_day) as month,
        day(date_day) as day_of_month,
        weekofyear(date_day) as week_of_year,
        quarter(date_day) as quarter,
        dayofweek(date_day) as day_of_week,
        case 
            when dayofweek(date_day) in (1, 7) then true 
            else false 
        end as is_weekend,
        date_format(date_day, 'MMMM') as month_name,
        date_format(date_day, 'EEEE') as day_name
    from date_spine
)

select
    date_day as date_id,
    date_day,
    year,
    month,
    day_of_month,
    week_of_year,
    quarter,
    day_of_week,
    is_weekend,
    month_name,
    day_name,
    current_timestamp as created_at,
    current_timestamp as updated_at
from date_details
    )
