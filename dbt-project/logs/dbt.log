[0m16:36:40.247169 [debug] [Thread-1 (]: On model.esg_analytics.dim_company: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "esg_trino", "target_name": "dev", "node_id": "model.esg_analytics.dim_company"} */

  
    

    create table "delta"."default_marts"."dim_company"
      
      
    as (
      

with companies as (
    select
        matched_company_id as company_id,
        company_name, -
        isin,
        sector,
        industry,
        sub_industry,
        city,
        country,
        region,
        initcap(name_norm) as name_norm_init,
        initcap(sector_norm) as sector_norm_init,
        initcap(industry_norm) as industry_norm_init,
        initcap(country_norm) as country_norm_init,
        isin_valid,
        row_number() over (partition by matched_company_id order by 
            case 
                when isin_valid = true then 1
                when sector is not null then 2
                when industry is not null then 3
                else 4
            end
        ) as rn
    from "delta"."default"."staging_companies_mapping"
),

deduplicated as (
    select
        company_id,
        company_name,
        symbol,
        isin,
        sector,
        industry,
        sub_industry,
        city,
        country,
        region,
        name_norm_init,
        sector_norm_init,
        industry_norm_init,
        country_norm_init,
        isin_valid
    from companies
    where rn = 1
)

select
    company_id,
    company_name, 
    symbol,
    isin,
    sector,
    industry,
    sub_industry,
    city,
    country,
    region,
    name_norm_init as company_name_normalized,
    sector_norm_init as sector_normalized,
