    create table "delta"."default_marts"."dim_metric"
      
      
    as (
      

with metric_dedup as (
    select
        staging_metric_id as metric_id,
        metric_name,
        metric_group,
        topic,
        current_timestamp as created_at,
        current_timestamp as updated_at,
        row_number() over (
            partition by staging_metric_id 
            order by 
                case when metric_name is not null then 1 else 2 end,
                updated_at desc
        ) as rn
    from "delta"."default"."staging_metrics"
)

select
    metric_id,
    metric_name,
    initcap(metric_group) as metric_group,
    initcap(topic) as topic,
    created_at,
    updated_at
from metric_dedup
where rn = 1
    )
