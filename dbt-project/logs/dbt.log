  , DATE_TRUNC('month', created_at) AS score_created_at__month
  , DATE_TRUNC('quarter', created_at) AS score_created_at__quarter
  , DATE_TRUNC('year', created_at) AS score_created_at__year
  , EXTRACT(year FROM created_at) AS score_created_at__extract_year
  , EXTRACT(quarter FROM created_at) AS score_created_at__extract_quarter
  , EXTRACT(month FROM created_at) AS score_created_at__extract_month
  , EXTRACT(day FROM created_at) AS score_created_at__extract_day
  , EXTRACT(DAY_OF_WEEK FROM created_at) AS score_created_at__extract_dow
  , EXTRACT(doy FROM created_at) AS score_created_at__extract_doy
  , source
  , total_level
  , total_grade
  , esg_risk_level
  , esg_risk_percentile
  , controversy_level
