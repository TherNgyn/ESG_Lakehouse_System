                case when note is not null then 1 else 2 end,
                staging_unit_id desc
        ) as rn
    from "delta"."default"."staging_units"
)

select
    unit_key,
    original_unit,
    standard_unit,
    conversion_factor,
    unit_category,
    conversion_note,
    created_at,
    updated_at
from unit_ranking
where rn = 1
    )
