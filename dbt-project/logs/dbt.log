[0m16:36:40.248813 [debug] [Thread-2 (]: On model.esg_analytics.dim_date: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "esg_trino", "target_name": "dev", "node_id": "model.esg_analytics.dim_date"} */

  
    

    create table "delta"."default_marts"."dim_date"
      
      
    as (
      

SELECT 
    date_column,
    EXTRACT(YEAR FROM date_column) AS year,
    EXTRACT(MONTH FROM date_column) AS month,
    date_column + INTERVAL '1' DAY AS next_day 
FROM "delta"."default_util"."time_spine"

date_details as (
    select
        date_day,
        year(date_day) as year,
        month(date_day) as month,
        day(date_day) as day_of_month,
        weekofyear(date_day) as week_of_year,
        quarter(date_day) as quarter,
        dayofweek(date_day) as day_of_week,
        case 
            when dayofweek(date_day) in (1, 7) then true 
            else false 
        end as is_weekend,
        date_format(date_day, 'MMMM') as month_name,
        date_format(date_day, 'EEEE') as day_name
    from date_spine
)

select
    date_day as date_id,
    date_day,
    year,
    month,
    day_of_month,
    week_of_year,
    quarter,
    day_of_week,
    is_weekend,
    month_name,
    day_name,
    current_timestamp as created_at,
    current_timestamp as updated_at
from date_details
    )
[0m16:36:40.249575 [debug] [Thread-4 (]: On model.esg_analytics.dim_unit: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "esg_trino", "target_name": "dev", "node_id": "model.esg_analytics.dim_unit"} */

  
    

    create table "delta"."default_marts"."dim_unit"
      
      
    as (
      

with unit_ranking as (
    select
        staging_unit_id as unit_id,
        original_unit,
        standard_unit,
        conversion_factor,
        unit_category,
        note as conversion_note,
        current_timestamp as created_at,
        current_timestamp as updated_at,
          row_number() over (
            partition by original_unit, standard_unit 
            order by 
                case when conversion_factor is not null then 1 else 2 end,
                case when note is not null then 1 else 2 end,
                staging_unit_id desc
        ) as rn
    from "delta"."default"."staging_units"
)

select
    unit_id,
    original_unit,
    standard_unit,
    conversion_factor,
    unit_category,
    conversion_note,
    created_at,
    updated_at
from unit_ranking
where rn = 1
    )
