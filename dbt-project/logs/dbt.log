    create table "delta"."default_marts"."dim_unit"
      
      
    as (
      

with unit_ranking as (
    select
        staging_unit_id as unit_key,
        original_unit,
        standard_unit,
        conversion_factor,
        unit_category,
        note as conversion_note,
        current_timestamp as created_at,
        current_timestamp as updated_at,
          row_number() over (
            partition by original_unit, standard_unit 
            order by 
                case when conversion_factor is not null then 1 else 2 end,
                case when note is not null then 1 else 2 end,
                staging_unit_id desc
        ) as rn
    from "delta"."default"."staging_units"
)

select
    unit_key,
    original_unit,
    standard_unit,
    conversion_factor,
    unit_category,
    conversion_note,
    created_at,
    updated_at
from unit_ranking
where rn = 1
    )
[0m18:44:40.713190 [debug] [Thread-2 (]: On model.esg_analytics.dim_date: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "esg_trino", "target_name": "dev", "node_id": "model.esg_analytics.dim_date"} */

  
    

    create table "delta"."default_marts"."dim_date"
      
      
    as (
      

with date_spine as (
    select date_day
    from "delta"."default_util"."time_spine"
),

date_details as (
    select
        date_day,
        extract(year from date_day) as year,
        extract(month from date_day) as month,
        extract(day from date_day) as day_of_month,
        extract(week from date_day) as week_of_year,
        extract(quarter from date_day) as quarter,
        extract(dow from date_day) as day_of_week,
        case 
            when extract(dow from date_day) in (7, 1) then true 
            else false 
        end as is_weekend,
        format_datetime(date_day, 'MMMM') as month_name,
        format_datetime(date_day, 'EEEE') as day_name
    from date_spine
)

select
    date_day as date_id,
    date_day,
    year,
    month,
    day_of_month,
    week_of_year,
    quarter,
    day_of_week,
    is_weekend,
    month_name,
    day_name,
    current_timestamp as created_at,
    current_timestamp as updated_at
from date_details
    )
