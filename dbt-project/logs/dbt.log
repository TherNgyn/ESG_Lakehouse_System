-- Metric Time Dimension 'score_date'
-- Pass Only Elements: [
--   'source',
--   'total_level',
--   'total_grade',
--   'esg_risk_level',
--   'esg_risk_percentile',
--   'controversy_level',
--   'score_date__year',
--   'score_date__extract_year',
--   'score_created_at__day',
--   'score_created_at__week',
--   'score_created_at__month',
--   'score_created_at__quarter',
--   'score_created_at__year',
--   'score_created_at__extract_year',
--   'score_created_at__extract_quarter',
--   'score_created_at__extract_month',
--   'score_created_at__extract_day',
--   'score_created_at__extract_dow',
--   'score_created_at__extract_doy',
-- ]
SELECT
  DATE_TRUNC('year', case when year is not null then cast(cast(year as varchar) || '-01-01' as date) else current_date end) AS score_date__year
  , EXTRACT(year FROM case when year is not null then cast(cast(year as varchar) || '-01-01' as date) else current_date end) AS score_date__extract_year
  , DATE_TRUNC('day', created_at) AS score_created_at__day
  , DATE_TRUNC('week', created_at) AS score_created_at__week
  , DATE_TRUNC('month', created_at) AS score_created_at__month
  , DATE_TRUNC('quarter', created_at) AS score_created_at__quarter
  , DATE_TRUNC('year', created_at) AS score_created_at__year
  , EXTRACT(year FROM created_at) AS score_created_at__extract_year
  , EXTRACT(quarter FROM created_at) AS score_created_at__extract_quarter
  , EXTRACT(month FROM created_at) AS score_created_at__extract_month
  , EXTRACT(day FROM created_at) AS score_created_at__extract_day
  , EXTRACT(DAY_OF_WEEK FROM created_at) AS score_created_at__extract_dow
  , EXTRACT(doy FROM created_at) AS score_created_at__extract_doy
  , source
  , total_level
  , total_grade
  , esg_risk_level
  , esg_risk_percentile
  , controversy_level
FROM "delta"."default_marts"."fact_esg_score_risk" esg_scores_src_0
