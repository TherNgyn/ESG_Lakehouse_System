    create table "delta"."default_marts"."fact_esg_metric"
      
      
    as (
      

with normalized_data as (
    select
        n.name as company_name,
        n.metric_norm as metric_name,
        n.year,
        n.value,
        n.units as original_unit,
        n.updated_at,
        n.extract_date
    from "delta"."default"."normalized_metrics" n
    
),
deduplicated_source as (
    select * from (
        select *,
               row_number() over (
                   partition by company_name, metric_name, year, original_unit 
                   order by updated_at desc, extract_date desc
               ) as rn
        from normalized_data
    ) where rn = 1
),

with_company_id as (
    select
        nd.*,
        c.company_key as company_id
    from normalized_data nd
    left join "delta"."default_marts"."dim_company" c
        on lower(trim(nd.company_name)) = lower(trim(c.company_name_normalized))
),

with_metric_id as (
    select
        wc.*,
        m.metric_key as metric_id
    from with_company_id wc
    left join "delta"."default_marts"."dim_metric" m
        on wc.metric_name = m.metric_name
),

with_unit_id as (
    select
        wm.*,
        u.unit_key as unit_id,
        u.standard_unit,
        u.conversion_factor,
        u.unit_category
    from with_metric_id wm
    left join "delta"."default_marts"."dim_unit" u
        on wm.original_unit = u.original_unit
),

final as (
    select
        /* Thêm unit_id vào key để đảm bảo duy nhất nếu 1 metric có nhiều đơn vị báo cáo */
        to_hex(md5(to_utf8(concat(
            coalesce(cast(company_id as varchar), company_name),
            coalesce(cast(metric_id as varchar), metric_name),
            cast(year as varchar),
            coalesce(cast(unit_id as varchar), 'no_unit')
        )))) as metric_key,
        company_id,
        metric_id,
        unit_id,
        year,
        value as original_value,
        case 
            when unit_category in ('intensity', 'volume_mass_mixed') then value
            else value * coalesce(conversion_factor, 1.0)
        end as normalized_value,
        standard_unit,
        current_timestamp as created_at,
        current_timestamp as updated_at
    from with_unit_id
    where company_id is not null 
      and metric_id is not null
)

select * from (
    select *,
           row_number() over (partition by metric_key order by created_at desc) as dbt_dedup_rn
    from final
) where dbt_dedup_rn = 1
    )
