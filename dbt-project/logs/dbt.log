[0m16:53:24.457807 [debug] [Thread-1 (]: On model.esg_analytics.fact_esg_metric: /* {"app": "dbt", "dbt_version": "1.11.2", "profile_name": "esg_trino", "target_name": "dev", "node_id": "model.esg_analytics.fact_esg_metric"} */

  
    

    create table "delta"."default_marts"."fact_esg_metric"
      
      
    as (
      

with normalized_data as (
    select
        n.name as company_name,
        n.metric_norm as metric_name,
        n.year,
        n.value,
        n.units as original_unit,
    from "delta"."default"."normalized_metrics" n
    
),

with_company_id as (
    select
        nd.*,
        c.company_id
    from normalized_data nd
    left join "delta"."default_marts"."dim_company" c
        on lower(trim(nd.company_name)) = lower(trim(c.company_name_normalized))
),

with_metric_id as (
    select
        wc.*,
        m.metric_key as metric_id -- Khớp với alias trong dim_metric
    from with_company_id wc
    left join "delta"."default_marts"."dim_metric" m
        on wc.metric_name = m.metric_name
),

with_unit_id as (
    select
        wm.*,
        u.unit_key as unit_id, -- Khớp với alias trong dim_unit
        u.standard_unit,
        u.conversion_factor,
        u.unit_category
    from with_metric_id wm
    left join "delta"."default_marts"."dim_unit" u
        on wm.original_unit = u.original_unit
),

final as (
    select
       
        to_hex(md5(to_utf8(concat(
            coalesce(company_id, company_name),
            coalesce(metric_id, metric_name),
            cast(year as varchar),
            source
        )))) as metric_key,
        company_id,
        metric_id,
        unit_id,
        year,
        value as original_value,
        case 
            when unit_category in ('intensity', 'volume_mass_mixed') then value
            else value * coalesce(conversion_factor, 1.0)
        end as normalized_value,
        standard_unit,
        source,
        entity,
        activity,
        measure,
        norm_confidence,
        norm_filter,
        current_timestamp as created_at,
        current_timestamp as updated_at
    from with_unit_id
    where company_id is not null 
      and metric_id is not null
)

select * from final
    )
