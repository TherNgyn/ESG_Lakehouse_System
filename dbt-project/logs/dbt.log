    from "delta"."default"."staging_metrics"
)

select
    metric_key,
    metric_name,
    upper(substring(metric_group, 1, 1)) || lower(substring(metric_group, 2)) as metric_group,
    upper(substring(topic, 1, 1)) || lower(substring(topic, 2)) as topic,
    created_at,
    updated_at
from metric_dedup
where rn = 1
    )
