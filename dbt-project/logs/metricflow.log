      DATE_TRUNC('year', case when year is not null then cast(cast(year as varchar) || '-01-01' as date) else current_date end) AS metric_time__year
      , overall_score AS avg_overall_score
    FROM "delta"."default_marts"."fact_esg_score_risk" esg_scores_src_10000
  ) subq_2
  GROUP BY
    metric_time__year

