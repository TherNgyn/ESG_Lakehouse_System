    , EXTRACT(quarter FROM created_at) AS created_at__extract_quarter
    , EXTRACT(month FROM created_at) AS created_at__extract_month
    , EXTRACT(day FROM created_at) AS created_at__extract_day
    , EXTRACT(DAY_OF_WEEK FROM created_at) AS created_at__extract_dow
    , EXTRACT(doy FROM created_at) AS created_at__extract_doy
    , metric_name
    , metric_group
    , topic
  FROM "delta"."default_marts"."dim_metric" metric_dim_src_0

