  -- Aggregate Measures
  -- Compute Metrics via Expressions
  SELECT
    metric_time__year
    , AVG(avg_overall_score) AS company_overall_score
  FROM (
    -- Read Elements From Semantic Model 'esg_scores'
    -- Metric Time Dimension 'score_date'
    -- Pass Only Elements: ['avg_overall_score', 'metric_time__year']
