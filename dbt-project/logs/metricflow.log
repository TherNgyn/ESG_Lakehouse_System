  --   'created_at__extract_day',
  --   'created_at__extract_dow',
  --   'created_at__extract_doy',
  -- ]
  SELECT
    DATE_TRUNC('day', created_at) AS created_at__day
    , DATE_TRUNC('week', created_at) AS created_at__week
    , DATE_TRUNC('month', created_at) AS created_at__month
    , DATE_TRUNC('quarter', created_at) AS created_at__quarter
